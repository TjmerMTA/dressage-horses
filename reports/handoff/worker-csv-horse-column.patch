+/** The horse a lead is about, from the page it was sent from: /#quiz?horse=<slug> or ?horse=<slug>. */
+export function horseFromPage(page: string | undefined): string {
+  if (!page) return "";
+  try {
+    const u = new URL(page);
+    const fromHash = u.hash.startsWith("#quiz?") ? new URLSearchParams(u.hash.slice(6)).get("horse") : null;
+    const slug = fromHash ?? u.searchParams.get("horse") ?? "";
+    return /^[a-z0-9][a-z0-9-]{0,79}$/.test(slug) ? slug : "";
+  } catch {
+    return "";
+  }
+}
