---
// The mock-up's 4-step quiz. Markup, styles and behaviour are the mock-up's; the texts
// come from home.json and the links/endpoint from site.json, handed to the script as
// JSON so the (bundled, deferred) script itself contains no copy.
import { getHome, getSite } from '../lib/texts';
import { getLegalFacts } from '../lib/legal';
import { whatsappHref } from '../scripts/site-values.js';

const { quiz } = await getHome();
const site = await getSite();
// Without JavaScript the quiz cannot be sent, so the fallback line must name a route
// that really exists today — never "the contact details in the imprint", which are empty.
const legal = await getLegalFacts();
const noJs = legal.whatsapp
  ? { href: legal.whatsapp, label: quiz.noScriptLink }
  : legal.email
    ? { href: `mailto:${legal.email}`, label: quiz.noScriptEmail }
    : null;

const data = {
  ...quiz,
  endpoint: site.endpoint,
  whatsapp: whatsappHref(site.links.whatsapp) ?? '',
  // Without a WhatsApp number, the error message does not send people to WhatsApp.
  errors: { ...quiz.errors, send: whatsappHref(site.links.whatsapp) || !quiz.errors.sendNoWhatsapp ? quiz.errors.send : quiz.errors.sendNoWhatsapp },
};
// Safe to embed inside <script type="application/json">.
const json = JSON.stringify(data).replace(/</g, '\\u003c');
const firstLabel = quiz.stepLabel.replace('{step}', '1').replace('{total}', '4');
---

<section class="quiz-sec" id="quiz" aria-labelledby="quiz-h">
  <div class="wrap">
    <div class="quiz-head">
      <h2 id="quiz-h">{quiz.title}</h2>
      <p>{quiz.intro}</p>
    </div>
    <div class="quiz" id="quiz-box">
      <div id="quiz-flow">
        <div class="prog" id="prog" aria-hidden="true" hidden>
          <span id="prog-label">{firstLabel}</span>
          <div class="prog-track"><div class="prog-fill" id="prog-fill"></div></div>
        </div>
        {/* Shown while the page is parsed, so it costs no layout shift. Without JavaScript
            there are no steps, so "Step 1 of 4" stays hidden and the box says what it is. */}
        <script is:inline>document.getElementById('prog').hidden = false;</script>
        <div id="steps" aria-live="polite">
          <noscript><p class="q-nojs">{quiz.noScript} {noJs ? <a href={noJs.href}>{noJs.label}</a> : quiz.noScriptNone}</p></noscript>
        </div>
        <div class="q-nav"><button type="button" class="link-btn" id="back" hidden>{quiz.back}</button></div>
      </div>
    </div>
  </div>
  <script type="application/json" id="quiz-data" set:html={json} />
</section>

<script>
  import { sendLead } from '../scripts/lead-form.js';

  type StepKey = 'region' | 'budget' | 'format';
  interface QuizData {
    stepLabel: string;
    steps: { key: StepKey; title: string; options: { icon: string; answer: string }[] }[];
    contactTitle: string;
    nameLabel: string;
    whatsappLabel: string;
    whatsappPlaceholder: string;
    whatsappHint: string;
    consent: string;
    submit: string;
    sending: string;
    errors: { name: string; whatsapp: string; consent: string; send: string };
    endpoint: string;
  }

  const dataEl = document.getElementById('quiz-data');
  const Q: QuizData | null = dataEl ? JSON.parse(dataEl.textContent || 'null') : null;

  if (Q) {
    const STEPS = Q.steps;
    const TOTAL = 4;
    const answers = { region: '', budget: '', format: '', name: '', whatsapp: '' };
    let step = 0;
    const stepsEl = document.getElementById('steps') as HTMLElement;
    const backBtn = document.getElementById('back') as HTMLButtonElement;
    const fill = document.getElementById('prog-fill') as HTMLElement;
    const label = document.getElementById('prog-label') as HTMLElement;

    const el = <K extends keyof HTMLElementTagNameMap>(tag: K, cls?: string, text?: string) => {
      const e = document.createElement(tag);
      if (cls) e.className = cls;
      if (text) e.textContent = text;
      return e;
    };

    // An invalid field is marked on the field itself (aria-invalid, red border) and points
    // at its own message through aria-describedby, set when the field is built.
    const isInvalid = (input: HTMLInputElement) => input.getAttribute('aria-invalid') === 'true';
    const setFieldError = (input: HTMLInputElement, msg: HTMLElement, text: string) => {
      msg.textContent = text;
      if (text) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    };

    const setProgress = () => {
      label.textContent = Q.stepLabel.replace('{step}', String(step + 1)).replace('{total}', String(TOTAL));
      fill.style.width = ((step + 1) / TOTAL) * 100 + '%';
      backBtn.hidden = step === 0;
    };

    const renderOptionStep = (i: number, probe = false) => {
      const s = STEPS[i];
      const wrap = el('div');
      const h = el('h3', 'q-title', s.title);
      h.tabIndex = -1;
      if (!probe) h.id = 'q-title';
      wrap.appendChild(h);
      const grid = el('div', 'opts');
      s.options.forEach(({ icon, answer: opt }) => {
        // The emoji is decoration for the eye only: aria-hidden, so the button's name is
        // the plain answer; and the words stand on their own if the font lacks the glyph.
        const b = el('button', 'opt');
        if (icon) {
          const ic = el('span', 'opt-icon', icon);
          ic.setAttribute('aria-hidden', 'true');
          b.appendChild(ic);
        }
        b.appendChild(el('span', 'opt-text', opt));
        b.type = 'button';
        b.setAttribute('aria-pressed', String(answers[s.key] === opt));
        b.addEventListener('click', () => {
          answers[s.key] = opt;
          grid.querySelectorAll('.opt').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
          setTimeout(() => go(step + 1), 220);
        });
        grid.appendChild(b);
      });
      wrap.appendChild(grid);
      return wrap;
    };

    const renderContactStep = () => {
      const wrap = el('div');
      const h = el('h3', 'q-title', Q.contactTitle);
      h.tabIndex = -1;
      h.id = 'q-title';
      wrap.appendChild(h);
      const form = el('form', 'form-grid');
      form.noValidate = true;

      const f1 = el('div', 'field');
      const l1 = el('label', '', Q.nameLabel); l1.htmlFor = 'f-name';
      const i1 = el('input'); i1.type = 'text'; i1.id = 'f-name'; i1.name = 'name'; i1.autocomplete = 'name'; i1.value = answers.name;
      i1.setAttribute('aria-describedby', 'e-name');
      const e1 = el('div', 'err'); e1.id = 'e-name';
      f1.append(l1, i1, e1);

      const f2 = el('div', 'field');
      const l2 = el('label', '', Q.whatsappLabel); l2.htmlFor = 'f-wa';
      const i2 = el('input'); i2.type = 'tel'; i2.id = 'f-wa'; i2.name = 'whatsapp'; i2.autocomplete = 'tel'; i2.inputMode = 'tel'; i2.placeholder = Q.whatsappPlaceholder; i2.value = answers.whatsapp;
      i2.setAttribute('aria-describedby', 'h-wa e-wa');
      const hint = el('div', 'hint', Q.whatsappHint); hint.id = 'h-wa';
      const e2 = el('div', 'err'); e2.id = 'e-wa';
      f2.append(l2, i2, hint, e2);

      const c = el('label', 'consent');
      const cb = el('input'); cb.type = 'checkbox'; cb.id = 'f-consent';
      cb.setAttribute('aria-describedby', 'e-consent');
      const ct = el('span', '', Q.consent);
      c.append(cb, ct);
      const e3 = el('div', 'err'); e3.id = 'e-consent';
      // Honeypot for bots: off-screen, out of the tab order and hidden from screen readers.
      const trap = el('div', 'hp'); trap.setAttribute('aria-hidden', 'true');
      const trapInput = el('input'); trapInput.type = 'text'; trapInput.name = 'website'; trapInput.tabIndex = -1; trapInput.autocomplete = 'off';
      trap.appendChild(trapInput);

      const actions = el('div', 'form-actions');
      const submit = el('button', 'btn', Q.submit);
      submit.type = 'submit';
      actions.appendChild(submit);

      form.append(f1, f2, c, e3, trap, actions);
      const nameOk = () => i1.value.trim().length >= 2;
      const waOk = () => { const n = i2.value.replace(/\D/g, '').length; return n >= 7 && n <= 15; };
      // A message disappears as soon as its field becomes valid, not at the next submit.
      // New messages appear only on submit, never while the visitor is still typing.
      i1.addEventListener('input', () => { if (isInvalid(i1) && nameOk()) setFieldError(i1, e1, ''); });
      i2.addEventListener('input', () => { if (isInvalid(i2) && waOk()) setFieldError(i2, e2, ''); });
      cb.addEventListener('change', () => { if (isInvalid(cb) && cb.checked) setFieldError(cb, e3, ''); });
      form.addEventListener('submit', (ev) => {
        ev.preventDefault();
        e3.textContent = ''; // may hold a "sending failed" message from an earlier attempt
        setFieldError(i1, e1, nameOk() ? '' : Q.errors.name);
        setFieldError(i2, e2, waOk() ? '' : Q.errors.whatsapp);
        setFieldError(cb, e3, cb.checked ? '' : Q.errors.consent);
        const firstBad = [i1, i2, cb].find(isInvalid);
        if (firstBad) { firstBad.focus(); return; }
        const name = i1.value.trim();
        const wa = i2.value.trim();
        answers.name = name;
        answers.whatsapp = wa;
        send(submit, trapInput.value, { name: e1, whatsapp: e2, other: e3 }, { name: i1, whatsapp: i2 });
      });
      wrap.appendChild(form);
      return wrap;
    };

    // Keeps the box from changing height between the three answer steps (they have
    // different numbers of answers): #steps is as tall as the tallest of them, measured in
    // an invisible copy at the current width. The contact step is taller still; the
    // change to and from it is animated instead of jumping.
    const flow = document.getElementById('quiz-flow') as HTMLElement;
    const measurer = el('div', 'q-measure');
    measurer.setAttribute('aria-hidden', 'true');
    measurer.inert = true;
    flow.appendChild(measurer);
    const measure = () => {
      let tallest = 0;
      STEPS.forEach((_, i) => {
        measurer.replaceChildren(renderOptionStep(i, true));
        tallest = Math.max(tallest, measurer.getBoundingClientRect().height);
      });
      measurer.replaceChildren();
      stepsEl.style.minHeight = tallest ? Math.ceil(tallest) + 'px' : '';
    };
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    const animateFrom = (from: number) => {
      const to = stepsEl.offsetHeight;
      if (reducedMotion.matches || Math.abs(from - to) < 2 || typeof stepsEl.animate !== 'function') return;
      stepsEl.style.overflow = 'hidden';
      const a = stepsEl.animate([{ height: from + 'px' }, { height: to + 'px' }], { duration: 260, easing: 'ease-out' });
      const done = () => { stepsEl.style.overflow = ''; };
      a.onfinish = done;
      a.oncancel = done;
    };

    // `focus` is false only for the very first render on page load, so the page does not
    // jump keyboard / screen-reader focus into the quiz before the visitor reaches it.
    const go = (n: number, focus = true) => {
      const from = stepsEl.offsetHeight;
      step = Math.max(0, Math.min(TOTAL - 1, n));
      stepsEl.replaceChildren(step < 3 ? renderOptionStep(step) : renderContactStep());
      setProgress();
      if (focus) animateFrom(from);
      const t = document.getElementById('q-title');
      if (t && focus) t.focus({ preventScroll: true });
    };

    backBtn.addEventListener('click', () => go(step - 1));

    // The POST itself (payload, timestamp, honeypot, tracking) lives in src/scripts/lead-form.js.
    const send = async (
      btn: HTMLButtonElement,
      honeypot: string,
      errs: { name: HTMLElement; whatsapp: HTMLElement; other: HTMLElement },
      inputs: { name: HTMLInputElement; whatsapp: HTMLInputElement },
    ) => {
      btn.disabled = true;
      btn.textContent = Q.sending;
      const result = await sendLead(
        { region: answers.region, budget: answers.budget, format: answers.format, name: answers.name, whatsapp: answers.whatsapp, consent: true, website: honeypot, page: location.href },
        Q.endpoint ? { endpoint: Q.endpoint } : {},
      );
      if (result.ok) {
        // The thank-you page (src/pages/thanks.astro). "?sent=1" tells it this visit really
        // follows a sent quiz, so the Meta Pixel's Lead is counted once and never for a
        // reload or a direct visit; the page removes it from the address straight away.
        // Coming back with the browser's Back button restores this page as it was left;
        // the button must not stay on "Sending…".
        addEventListener('pageshow', (e) => { if (e.persisted) { btn.disabled = false; btn.textContent = Q.submit; } }, { once: true });
        location.assign('/thanks/?sent=1');
        return;
      }
      btn.disabled = false;
      btn.textContent = Q.submit;
      if (result.field === 'name') { setFieldError(inputs.name, errs.name, Q.errors.name); inputs.name.focus(); }
      else if (result.field === 'contact') { setFieldError(inputs.whatsapp, errs.whatsapp, Q.errors.whatsapp); inputs.whatsapp.focus(); }
      else errs.other.textContent = result.reason === 'rate-limited' || result.reason === 'network' ? result.message : Q.errors.send;
    };
    go(0, false);
    measure();
    let measuredWidth = stepsEl.clientWidth;
    new ResizeObserver(() => {
      if (stepsEl.clientWidth === measuredWidth) return; // own height changes are not a reason
      measuredWidth = stepsEl.clientWidth;
      measure();
    }).observe(stepsEl);
  }
</script>

<style is:global>
  /* Global, not scoped: most of the quiz is built by the script at runtime, and
     runtime-created elements do not carry Astro's scoping attribute. */
  .quiz-sec { padding: 4.5rem 0; }
  .quiz-head { text-align: center; max-width: 40rem; margin-block: 0 2rem; margin-inline: auto; }
  .quiz-head h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); }
  .quiz-head p { margin-block-start: 0.8rem; color: var(--muted); }
  #quiz-flow { position: relative; }
  .q-measure { position: absolute; inset-inline: 0; inset-block-start: 0; visibility: hidden; pointer-events: none; }
  .q-nojs { color: var(--muted); }
  .q-nojs a { color: var(--accent-text); font-weight: 600; text-underline-offset: 3px; }
  .quiz { max-width: 44rem; margin-inline: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 24px; padding: clamp(1.3rem, 4vw, 2.4rem); box-shadow: 0 10px 40px rgba(41,19,5,.08); }
  .prog { display: flex; align-items: center; gap: 1rem; margin-block-end: 1.6rem; font-size: 0.85rem; color: var(--muted); }
  .prog-track { flex: 1; height: 8px; border-radius: 99px; background: var(--line); overflow: hidden; }
  .prog-fill { height: 100%; width: 25%; background: var(--accent); border-radius: 99px; transition: width .3s ease; }
  .q-title { font-size: clamp(1.35rem, 3.4vw, 1.8rem); margin-block-end: 1.3rem; }
  .q-title:focus { outline: none; }
  .opts { display: grid; gap: 0.8rem; grid-template-columns: repeat(auto-fit, minmax(min(100%, 13rem), 1fr)); }
  .opt { text-align: start; padding: 1.1rem 1.2rem; border: 2px solid var(--line); border-radius: 16px; background: var(--surface); color: var(--text); font: 600 1.02rem/1.35 var(--sans); cursor: pointer; transition: border-color .12s, background .12s, transform .12s, box-shadow .12s; min-height: 4rem; display: flex; align-items: center; box-shadow: 0 3px 0 var(--line-strong), 0 10px 20px rgba(41,19,5,.07); }
  .opt:hover { border-color: var(--accent); transform: translateY(-2px); box-shadow: 0 5px 0 var(--accent), 0 14px 24px rgba(41,19,5,.10); }
  .opt:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--line-strong), 0 4px 8px rgba(41,19,5,.08); }
  /* One emoji before the words, at the text's own size; it never shrinks or wraps away
     from them, and the words keep their own box so a long answer wraps beside it. */
  .opt-icon { flex: none; inline-size: 1.35em; margin-inline-end: 0.55em; font-size: 1em; line-height: 1; text-align: center; font-family: "Apple Color Emoji", "Segoe UI Emoji", "Noto Color Emoji", var(--sans); }
  .opt-text { min-inline-size: 0; }
  .opt[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-soft); box-shadow: 0 3px 0 var(--accent), 0 10px 20px rgba(41,19,5,.07); }
  .q-nav { margin-block-start: 1.4rem; min-height: 2.4rem; }
  .link-btn { background: none; border: 0; padding: 0.4rem 0; color: var(--muted); font: 600 0.95rem var(--sans); cursor: pointer; text-decoration: underline; text-underline-offset: 3px; }
  .form-grid { display: grid; gap: 1rem; }
  .hp { position: absolute; inset-inline-start: -10000px; width: 1px; height: 1px; overflow: hidden; }
  .field label { display: block; font-weight: 600; margin-block-end: 0.4rem; font-size: 0.95rem; }
  .field input[type="text"], .field input[type="tel"] { width: 100%; min-height: 3.3rem; padding: 0.7rem 1rem; border: 2px solid var(--line); border-radius: 14px; background: var(--surface); color: var(--text); font: 1.05rem var(--sans); }
  .field input:focus { border-color: var(--accent); outline: none; }
  .field input[aria-invalid="true"], .field input[aria-invalid="true"]:focus { border-color: var(--err); }
  .hint { font-size: 0.85rem; color: var(--muted); margin-block-start: 0.35rem; }
  .err { font-size: 0.88rem; color: var(--err); margin-block-start: 0.35rem; min-height: 1.2em; }
  .consent { display: grid; grid-template-columns: 1.4rem 1fr; gap: 0.7rem; align-items: start; font-size: 0.88rem; color: var(--muted); }
  .consent input { width: 1.25rem; height: 1.25rem; margin-block: 0.15rem 0; margin-inline: 0; accent-color: var(--accent); }
  .consent input[aria-invalid="true"] { outline: 2px solid var(--err); outline-offset: 2px; }
  .form-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem; margin-block-start: 0.4rem; }
</style>
