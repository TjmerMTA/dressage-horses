---
// The mock-up's <header class="hero">. The grey photo box (#photo-hero) now holds the
// real hero photograph as a <picture> (AVIF, WebP, JPEG). It is the LCP element:
// eager, fetchpriority high, and sizes matching the box it covers.
import { Picture } from 'astro:assets';
import SiteTop from './SiteTop.astro';
import { getHome } from '../lib/texts';

const { hero } = await getHome();
---

<header class="hero">
  <div class="photo photo-hero on" id="photo-hero" style={hero.photoPosition ? `--focus: ${hero.photoPosition}` : undefined}>
    <Picture
      src={hero.photo}
      alt={hero.photoAlt}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[480, 640, 960, 1280, 1600, 2000, 2400]}
      sizes="(max-width: 465px) 465px, (max-width: 899px) 100vw, 1200px"
      loading="eager"
      fetchpriority="high"
      decoding="async"
    />
  </div>
  <div class="wrap">
    <SiteTop />
    <div class="hero-main">
      <div class="eyebrow">{hero.eyebrow}</div>
      <h1>{hero.title}</h1>
      <p class="lead">{hero.lead}</p>
      <ul class="ticks">
        {hero.ticks.map((tick) => <li>{tick}</li>)}
      </ul>
      <div class="cta-row">
        <a class="btn" id="hero-cta" href="#quiz">{hero.cta}</a>
        <span class="cta-note">{hero.ctaNote}</span>
      </div>
    </div>
  </div>
</header>

<style>
  .photo-hero { inset-block: 0; inset-inline-end: 0; width: clamp(520px, 56%, 900px); --photo-pos: var(--focus, 62% 40%); --photo-op: .95;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to top, transparent 0%, #000 24%);
    -webkit-mask-composite: source-in;
    mask-image: linear-gradient(to right, transparent 0%, #000 42%), linear-gradient(to top, transparent 0%, #000 24%);
    mask-composite: intersect; }
  @media (max-width: 899px) {
    .photo-hero { inset-inline: 0; width: 100%; height: 310px; inset-block-end: auto; --photo-op: .95; --photo-pos: 58% 36%;
      -webkit-mask-image: linear-gradient(to bottom, #000 52%, transparent 100%); -webkit-mask-composite: source-over;
      mask-image: linear-gradient(to bottom, #000 52%, transparent 100%); mask-composite: add; }
  }

  .hero { position: relative; overflow: hidden; background: var(--bg); color: var(--text); }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-main { max-width: 37rem; padding-block: 2rem 3.6rem; padding-inline: 0; }
  @media (min-width: 900px) { .hero-main { padding-block: 4rem 5.5rem; } }
  @media (max-width: 899px) { .hero-main { padding-block-start: 10rem; } }
  .hero h1 { font-size: clamp(2.1rem, 5.4vw, 3.6rem); }
  .hero .lead { margin-block-start: 1.3rem; font-size: 1.1rem; color: var(--muted); }
</style>
