---
// The "Example listing" pill for sample horses. Same family as the dark "Sold" pill, but
// light: white, dark-brown text, the gold border and 3D bottom edge of the ghost buttons.
// `hidden` hides it from screen readers where the same words are already announced
// (the card's link carries them).
import { SAMPLE } from '../lib/sample';

interface Props {
  hidden?: boolean;
}

const { hidden = false } = Astro.props;
---

<span class="sample-pill" aria-hidden={hidden ? 'true' : undefined}>
  <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M8 1.6a6.4 6.4 0 1 0 0 12.8A6.4 6.4 0 0 0 8 1.6Zm0 3.1v.1m0 2.4v4.1" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" /></svg>
  {SAMPLE.badge}
</span>

<style>
  .sample-pill { display: inline-flex; align-items: center; gap: 0.4rem; padding-block: 0.3rem; padding-inline: 0.65rem 0.85rem; border: 1.5px solid var(--accent); border-radius: 999px; background: var(--surface); color: var(--accent-ink); font: 700 0.76rem/1.2 var(--sans); letter-spacing: 0.12em; text-transform: uppercase; white-space: nowrap; box-shadow: 0 3px 0 var(--accent), 0 8px 16px rgba(41,19,5,.18); }
  .sample-pill svg { flex: none; width: 1rem; height: 1rem; color: var(--accent-text); }
</style>
