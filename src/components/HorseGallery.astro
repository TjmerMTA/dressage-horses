---
// Photo gallery of a horse page. No library.
//  - Without JavaScript: a horizontal, scroll-snapping strip of photos; the thumbnails are
//    plain links to each photo (#photo-2 ...), so every photo is still reachable.
//  - With JavaScript: previous / next buttons, the arrow keys (and Home / End) on the
//    focused strip, thumbnails that show their photo, and a "Photo 2 of 6" counter.
// The first photo is the page's LCP image (eager, high priority); the rest are lazy.
import { Image, Picture } from 'astro:assets';
import type { Horse } from '../lib/horses';
import { fill, photoAlt } from '../lib/horses';
import { getCatalogue } from '../lib/texts';

interface Props {
  horse: Horse;
}

const { horse } = Astro.props;
const t = await getCatalogue();
const photos = horse.data.photos;
const total = photos.length;
const label = fill(t.detail.gallery, { name: horse.data.name });
const photoLabel = (i: number) => fill(t.detail.photo, { n: i + 1, total });
---

<div class="gallery" data-gallery data-label={t.detail.photo}>
  <div class="g-frame">
    <div class="g-track" tabindex="0" role="region" aria-label={label}>
      {photos.map((src, i) => (
        <div class="g-slide" id={`photo-${i + 1}`} role="group" aria-roledescription="slide" aria-label={photoLabel(i)}>
          <Picture
            src={src}
            alt={photoAlt(horse, i, t)}
            formats={['avif', 'webp']}
            fallbackFormat="jpg"
            widths={[480, 720, 960, 1280, 1600]}
            sizes="(max-width: 899px) calc(100vw - 2.5rem), 680px"
            loading={i === 0 ? 'eager' : 'lazy'}
            fetchpriority={i === 0 ? 'high' : undefined}
            decoding="async"
          />
        </div>
      ))}
    </div>
    {total > 1 && (
      <>
        <button type="button" class="g-btn g-prev" data-prev hidden aria-label={t.detail.prev}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="g-btn g-next" data-next hidden aria-label={t.detail.next}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </>
    )}
  </div>
  {total > 1 && (
    <div class="g-bar">
      <p class="g-count" data-count aria-live="polite" hidden>{photoLabel(0)}</p>
      <ul class="g-thumbs">
        {photos.map((src, i) => (
          <li>
            <a class="g-thumb" href={`#photo-${i + 1}`} data-thumb={i} aria-current={i === 0 ? 'true' : undefined}>
              <Image src={src} alt={photoLabel(i)} width={96} densities={[1, 2]} loading="lazy" decoding="async" />
            </a>
          </li>
        ))}
      </ul>
    </div>
  )}
</div>

<script>
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((g) => {
    const track = g.querySelector<HTMLElement>('.g-track');
    const slides = Array.from(g.querySelectorAll<HTMLElement>('.g-slide'));
    if (!track || slides.length < 2) return;
    const thumbs = Array.from(g.querySelectorAll<HTMLAnchorElement>('[data-thumb]'));
    const prev = g.querySelector<HTMLButtonElement>('[data-prev]');
    const next = g.querySelector<HTMLButtonElement>('[data-next]');
    const count = g.querySelector<HTMLElement>('[data-count]');
    const template = g.dataset.label || '{n} / {total}';
    const total = slides.length;
    let current = 0;

    const mark = (i: number) => {
      current = i;
      thumbs.forEach((a, j) => (j === i ? a.setAttribute('aria-current', 'true') : a.removeAttribute('aria-current')));
      // aria-disabled, not disabled: a disabled button would drop the keyboard focus.
      prev?.setAttribute('aria-disabled', String(i === 0));
      next?.setAttribute('aria-disabled', String(i === total - 1));
      if (count) count.textContent = template.replace('{n}', String(i + 1)).replace('{total}', String(total));
    };

    const go = (i: number) => {
      const n = Math.max(0, Math.min(total - 1, i));
      mark(n);
      // inline: 'start' scrolls the strip only; block: 'nearest' keeps the page still
      // when the gallery is already on screen.
      slides[n].scrollIntoView({ behavior: reduce.matches ? 'auto' : 'smooth', block: 'nearest', inline: 'start' });
    };

    // Follow swipes and native scrolling of the strip.
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) mark(slides.indexOf(e.target as HTMLElement));
        });
      },
      { root: track, threshold: 0.6 },
    );
    slides.forEach((s) => io.observe(s));

    prev?.addEventListener('click', () => go(current - 1));
    next?.addEventListener('click', () => go(current + 1));
    thumbs.forEach((a, i) =>
      a.addEventListener('click', (e) => {
        e.preventDefault();
        go(i);
      }),
    );

    track.addEventListener('keydown', (e) => {
      const rtl = getComputedStyle(track).direction === 'rtl';
      const fwd = rtl ? 'ArrowLeft' : 'ArrowRight';
      const back = rtl ? 'ArrowRight' : 'ArrowLeft';
      let target: number | null = null;
      if (e.key === fwd) target = current + 1;
      else if (e.key === back) target = current - 1;
      else if (e.key === 'Home') target = 0;
      else if (e.key === 'End') target = total - 1;
      if (target === null) return;
      e.preventDefault();
      go(target);
    });

    g.classList.add('js');
    [prev, next, count].forEach((el) => el && (el.hidden = false));
    mark(0);
  });
</script>

<style>
  .gallery { min-width: 0; }
  .g-frame { position: relative; }
  .g-track { display: flex; overflow-y: hidden; overflow-x: auto; scroll-snap-type: x mandatory; overscroll-behavior-x: contain; border-radius: 22px; background: var(--accent-soft); aspect-ratio: 4 / 3; }
  .g-track:focus-visible { outline-offset: 4px; }
  .gallery.js .g-track { scrollbar-width: none; }
  .gallery.js .g-track::-webkit-scrollbar { display: none; }
  .g-slide { position: relative; flex: 0 0 100%; height: 100%; scroll-snap-align: start; }
  /* Browsers treat a lazy image in a horizontal strip as "near the viewport" and fetch
     all of them at once. Skipping the rendering of off-screen slides keeps them lazy:
     a slide's photo loads only when the slide scrolls into view. */
  .g-slide + .g-slide { content-visibility: auto; }
  .g-slide picture { display: contents; }
  .g-slide img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: contain; }

  .g-btn { position: absolute; inset-block-start: 50%; margin-block-start: -1.5rem; display: grid; place-items: center; width: 3rem; height: 3rem; padding: 0; border-radius: 50%; border: 1.5px solid var(--line-strong); background: rgba(255,255,255,.94); color: var(--text); cursor: pointer; box-shadow: 0 3px 0 var(--line-strong), 0 10px 20px rgba(41,19,5,.12); transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease, opacity .12s ease; }
  .g-btn:hover { border-color: var(--accent); box-shadow: 0 5px 0 var(--accent), 0 14px 24px rgba(41,19,5,.14); }
  .g-btn:active { transform: translateY(2px); box-shadow: 0 1px 0 var(--line-strong), 0 4px 8px rgba(41,19,5,.10); }
  .g-btn[aria-disabled="true"] { opacity: .35; cursor: default; box-shadow: 0 3px 0 var(--line-strong); }
  .g-btn svg { width: 1.3rem; height: 1.3rem; }
  .g-btn:dir(rtl) svg { transform: scaleX(-1); }
  .g-prev { inset-inline-start: 0.8rem; }
  .g-next { inset-inline-end: 0.8rem; }

  .g-bar { display: flex; flex-wrap: wrap; align-items: center; gap: 0.6rem 1.2rem; margin-block-start: 0.9rem; }
  .g-count { font-size: 0.88rem; color: var(--muted); min-width: 7.5rem; }
  .g-thumbs { list-style: none; margin: 0; padding: 0.2rem; display: flex; gap: 0.5rem; overflow-x: auto; }
  .g-thumb { display: block; width: 4.4rem; height: 4.4rem; border-radius: 12px; overflow: hidden; border: 2px solid transparent; opacity: .75; transition: opacity .12s ease, border-color .12s ease; }
  .g-thumb:hover { opacity: 1; }
  .g-thumb[aria-current="true"] { border-color: var(--accent); opacity: 1; }
  .g-thumb img { display: block; width: 100%; height: 100%; object-fit: cover; }
</style>
