---
// Home page: a strip of four horses above the quiz — the featured ones first, filled up
// with the newest unsold horses. Left out entirely when there is no horse to show.
import HorseCard from './HorseCard.astro';
import { getCatalogue } from '../lib/texts';
import { getPublishedHorses, pickFeatured } from '../lib/horses';

const t = await getCatalogue();
const horses = pickFeatured(await getPublishedHorses(), 4);
---

{horses.length > 0 && (
  <section class="featured" aria-labelledby="featured-h">
    <div class="wrap">
      <div class="f-head">
        <div>
          <div class="eyebrow">{t.featured.eyebrow}</div>
          <h2 id="featured-h">{t.featured.title}</h2>
        </div>
        <a class="btn btn-ghost btn-sm" href="/horses/">{t.featured.all}</a>
      </div>
      <ul class="f-grid">
        {horses.map((horse) => <li><HorseCard horse={horse} /></li>)}
      </ul>
    </div>
  </section>
)}

<style>
  .featured { padding-block: 4.5rem 0; }
  .f-head { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: 1rem 2rem; margin-block-end: 2.2rem; }
  .featured h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); max-width: 34rem; }
  .f-grid { list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(1rem, 2.4vw, 1.6rem); grid-template-columns: repeat(4, minmax(0, 1fr)); }
  @media (max-width: 999px) { .f-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 519px) { .f-grid { grid-template-columns: 1fr; } }
</style>
