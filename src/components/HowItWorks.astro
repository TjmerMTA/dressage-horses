---
// The mock-up's "How it works" section (titled "How it works with us" there).
import { getHome } from '../lib/texts';

const { how } = await getHome();
---

<section class="how-sec" aria-labelledby="how-h">
  <div class="wrap">
    <div class="eyebrow">{how.eyebrow}</div>
    <h2 id="how-h">{how.title}</h2>
    <ol class="steps">
      {how.steps.map((s) => <li><strong>{s.title}</strong><span>{s.text}</span></li>)}
    </ol>
  </div>
</section>

<style>
  .how-sec { padding: 5rem 0; background: var(--surface); border-block: 1px solid var(--line); }
  .how-sec h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); max-width: 34rem; }
  .steps { list-style: none; margin-block: 2.6rem 0; margin-inline: 0; padding: 0; display: grid; gap: clamp(1.2rem, 3.2vw, 2.2rem); grid-template-columns: repeat(2, minmax(0, 1fr)); counter-reset: s; }
  .steps li { counter-increment: s; padding: clamp(1.4rem, 3vw, 2.2rem); border-radius: 22px; background: var(--accent-soft); }
  .steps li::before { content: counter(s); display: block; font-family: var(--serif); font-weight: 700; font-size: clamp(2.4rem, 6vw, 3.2rem); line-height: 1; color: var(--accent-text); margin-block-end: 0.9rem; }
  .steps strong { display: block; font-size: 1.15rem; line-height: 1.3; margin-block-end: 0.4rem; }
  .steps span { color: var(--muted); font-size: 0.97rem; }
  @media (max-width: 519px) { .steps { grid-template-columns: 1fr; } }
</style>
