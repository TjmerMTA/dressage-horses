---
// A closing call to action for the inner pages, built from the mock-up's quiz-head
// typography and the soft accent panel of its "How it works" cards.
interface Props {
  title: string;
  text: string;
  button: string;
}

const { title, text, button } = Astro.props;
---

<section class="cta-sec" aria-labelledby="cta-h">
  <div class="wrap">
    <div class="cta-panel">
      <h2 id="cta-h">{title}</h2>
      <p>{text}</p>
      <a class="btn" href="/#quiz">{button}</a>
    </div>
  </div>
</section>

<style>
  .cta-sec { padding-block: 5rem; }
  .cta-panel { text-align: center; max-width: 44rem; margin-inline: auto; padding: clamp(1.8rem, 5vw, 3rem); border-radius: 24px; background: var(--accent-soft); }
  .cta-panel h2 { font-size: clamp(1.7rem, 4vw, 2.5rem); }
  .cta-panel p { margin-block: 0.8rem 1.8rem; margin-inline: auto; max-width: 34rem; color: var(--muted); }
</style>
