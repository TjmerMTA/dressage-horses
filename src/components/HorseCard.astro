---
// One horse in the catalogue grid and in the home-page strip: cover photo, name, the key
// facts and the price. The whole card is clickable through the name's link (stretched
// with ::after), so there is one link per card for keyboard and screen-reader users.
import { Picture } from 'astro:assets';
import type { Horse } from '../lib/horses';
import { ageOf, countryLabel, fill, formatPrice, horseHref, levelLabel, photoAlt } from '../lib/horses';
import { getCatalogue } from '../lib/texts';

interface Props {
  horse: Horse;
  headingLevel?: 'h2' | 'h3';
}

const { horse, headingLevel = 'h3' } = Astro.props;
const Heading = headingLevel;
const t = await getCatalogue();
const { name, photos, height, level, sold } = horse.data;
---

<article class="horse-card" data-sold={sold ? '' : undefined}>
  <div class="hc-photo">
    <Picture
      src={photos[0]}
      alt={photoAlt(horse, 0, t)}
      formats={['avif', 'webp']}
      fallbackFormat="jpg"
      widths={[360, 540, 720, 960]}
      sizes="(max-width: 599px) calc(100vw - 2.5rem), (max-width: 999px) calc(50vw - 2rem), 360px"
      loading="lazy"
      decoding="async"
    />
    {sold && <span class="hc-ribbon">{t.labels.sold}</span>}
  </div>
  <div class="hc-body">
    <Heading class="hc-name"><a href={horseHref(horse)}>{name}</a></Heading>
    <ul class="hc-facts">
      <li>{fill(t.labels.age, { age: ageOf(horse) })}</li>
      <li>{fill(t.labels.height, { height })}</li>
      <li>{levelLabel(level, t)}</li>
      <li>{countryLabel(horse, t)}</li>
    </ul>
    <p class="hc-price">{sold ? t.labels.sold : formatPrice(horse, t)}</p>
  </div>
</article>

<style>
  .horse-card { position: relative; display: flex; flex-direction: column; height: 100%; background: var(--surface); border: 1px solid var(--line); border-radius: 22px; overflow: hidden; box-shadow: 0 3px 0 var(--line-strong), 0 10px 20px rgba(41,19,5,.07); transition: transform .12s ease, box-shadow .12s ease, border-color .12s ease; }
  .horse-card:hover { transform: translateY(-2px); border-color: var(--accent); box-shadow: 0 5px 0 var(--accent), 0 14px 24px rgba(41,19,5,.10); }
  .horse-card:focus-within { border-color: var(--accent); }
  .hc-photo { position: relative; aspect-ratio: 4 / 3; overflow: hidden; background: var(--accent-soft); }
  .hc-photo picture { display: contents; }
  .hc-photo img { position: absolute; inset: 0; display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; }
  .horse-card[data-sold] .hc-photo img { filter: saturate(.55); opacity: .85; }
  .hc-ribbon { position: absolute; inset-block-start: 1rem; inset-inline-start: 1rem; padding: 0.35rem 0.9rem; border-radius: 999px; background: var(--accent-ink); color: #FFFFFF; font: 700 0.78rem/1.2 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; box-shadow: 0 3px 0 #100600, 0 8px 16px rgba(41,19,5,.25); }
  .hc-body { display: flex; flex-direction: column; flex: 1; padding: 1.2rem 1.4rem 1.4rem; }
  .hc-name { font-size: 1.35rem; margin-block-end: 0.6rem; }
  .hc-name a { text-decoration: none; }
  .hc-name a::after { content: ""; position: absolute; inset: 0; border-radius: 22px; }
  .hc-name a:focus-visible { outline: none; }
  .hc-name a:focus-visible::after { outline: 3px solid var(--accent); outline-offset: -3px; }
  .hc-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.35rem 0.4rem; font-size: 0.88rem; color: var(--muted); }
  .hc-facts li { padding: 0.15rem 0.65rem; border-radius: 999px; background: var(--accent-soft); }
  .hc-price { margin-block-start: auto; padding-block-start: 1rem; font: 700 1.15rem/1.2 var(--serif); color: var(--text); }
  .horse-card[data-sold] .hc-price { color: var(--muted); }
</style>
