---
// The imprint. The company's legal facts live in the front matter of imprint.md (editable
// in the admin). Facts that are set are listed; the ones still missing are named in one
// dated sentence instead of "to be confirmed" placeholders. Nothing is ever made up.
// Facts and channels are read through src/lib/legal.ts, like the privacy policy.
import { getEntry, render } from 'astro:content';
import LegalPage from '../components/LegalPage.astro';
import { getLegalFacts, listText, lowerFirst } from '../lib/legal';

const entry = await getEntry('pages', 'imprint');
if (!entry) throw new Error('src/content/pages/imprint.md is missing');
const { Content } = await render(entry);
const { known, missing, email, whatsapp, asOf } = await getLegalFacts();
const one = missing.length === 1;
---

<LegalPage entry={entry}>
  <p>Information about the company that operates this website, as required by Belgian and EU law (Code of Economic Law, Book XII, and the EU e-Commerce Directive).</p>

  <h2>Company</h2>
  {known.length > 0 && (
    <ul>
      {known.map(({ label, value }) => <li><strong>{label}:</strong> {value}</li>)}
    </ul>
  )}
  {missing.length > 0 && (
    <p>
      As of {asOf}, {known.length > 0 ? 'the ' : 'our '}{listText(missing.map(lowerFirst))} {one ? 'is' : 'are'} not yet published on this page.{' '}
      {one ? 'It' : 'They'} will be added as soon as the company has confirmed {one ? 'it' : 'them'}.{' '}
      Until then, you can reach us through the <a href="/#quiz">quick quiz</a>.
    </p>
  )}

  <h2>Contact</h2>
  <ul>
    {whatsapp && <li><strong>WhatsApp:</strong> <a href={whatsapp} target="_blank" rel="noopener">write to us on WhatsApp</a></li>}
    {email && <li><strong>E-mail:</strong> <a href={`mailto:${email}`}>{email}</a></li>}
    <li><strong>Quiz:</strong> the <a href="/#quiz">four-question quiz</a> on our home page. Leave your name and WhatsApp number, and we’ll contact you on WhatsApp.</li>
  </ul>
  {!whatsapp && !email && (
    <p>As of {asOf}, no phone number, WhatsApp number or e-mail address of the company is published on this site, so the quiz is the one way to reach us through it.</p>
  )}

  <Content />
</LegalPage>
