---
// /horses/<slug>/ — one page per published horse. getStaticPaths reads the same
// getPublishedHorses() as the list, so an unpublished horse gets no page at all.
import { getImage } from 'astro:assets';
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHeader from '../../components/PageHeader.astro';
import HorseGallery from '../../components/HorseGallery.astro';
import CtaPanel from '../../components/CtaPanel.astro';
import { getCatalogue } from '../../lib/texts';
import {
  ageOf, countryLabel, enquiryHref, fill, formatPrice, getPublishedHorses, horseHref, levelLabel, photoAlt, sexLabel,
  type Horse,
} from '../../lib/horses';

export async function getStaticPaths() {
  const horses = await getPublishedHorses();
  return horses.map((horse) => ({ params: { slug: horse.id }, props: { horse } }));
}

interface Props {
  horse: Horse;
}

const { horse } = Astro.props;
const t = await getCatalogue();
const d = horse.data;
const { Content } = await render(horse);

const age = ageOf(horse);
const sex = sexLabel(horse, t).toLowerCase();
const level = levelLabel(d.level, t);
const country = countryLabel(horse, t);
const price = formatPrice(horse, t);
const vars = { name: d.name, age, colour: d.colour, sex, height: d.height, level, breed: d.breed, country, price };

const title = fill(t.detail.metaTitle, vars);
const description = fill(t.detail.metaDescription, vars);
const lead = fill(t.detail.lead, vars);

const facts: [string, string][] = [
  [t.detail.facts.price, d.sold ? t.labels.sold : price],
  [t.detail.facts.age, fill(t.labels.age, { age })],
  [t.detail.facts.born, String(d.year)],
  [t.detail.facts.height, fill(t.labels.height, { height: d.height })],
  [t.detail.facts.sex, sexLabel(horse, t)],
  [t.detail.facts.colour, d.colour.charAt(0).toUpperCase() + d.colour.slice(1)],
  [t.detail.facts.breed, d.breed],
  [t.detail.facts.level, level],
  [t.detail.facts.country, country],
  [t.detail.facts.xrays, t.detail.xrays[d.xrays]],
];

// A YouTube or Vimeo link becomes an embedded player (privacy-enhanced YouTube domain);
// any other address is shown as a link.
function embedUrl(url: string): string | null {
  try {
    const u = new URL(url);
    const host = u.hostname.replace(/^www\.|^m\./, '');
    let id: string | null = null;
    if (host === 'youtu.be') id = u.pathname.slice(1);
    else if (host === 'youtube.com' || host === 'youtube-nocookie.com') {
      id = u.searchParams.get('v') ?? u.pathname.match(/^\/(?:embed|shorts|live)\/([^/?]+)/)?.[1] ?? null;
    }
    if (id && /^[\w-]{6,20}$/.test(id)) return `https://www.youtube-nocookie.com/embed/${id}`;
    if (host === 'vimeo.com' || host === 'player.vimeo.com') {
      const v = u.pathname.match(/(\d{5,})/)?.[1];
      if (v) return `https://player.vimeo.com/video/${v}`;
    }
  } catch {}
  return null;
}
const embed = d.video ? embedUrl(d.video) : null;

const url = new URL(horseHref(horse), Astro.site).href;
const images = await Promise.all(d.photos.map((src) => getImage({ src, width: 1200, format: 'jpg' })));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: d.name,
  url,
  sku: horse.id,
  description,
  category: 'Dressage horse',
  image: images.map((img) => new URL(img.src, Astro.site).href),
  color: d.colour,
  additionalProperty: [
    { '@type': 'PropertyValue', name: 'Year of birth', value: d.year },
    { '@type': 'PropertyValue', name: 'Height', value: d.height, unitCode: 'CMT' },
    { '@type': 'PropertyValue', name: 'Sex', value: sexLabel(horse, t) },
    { '@type': 'PropertyValue', name: 'Studbook', value: d.breed },
    { '@type': 'PropertyValue', name: 'Level', value: level },
    { '@type': 'PropertyValue', name: 'Pedigree', value: `${d.sire} × ${d.dam} (${d.damsire})` },
  ],
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: d.currency,
    ...(d.priceOnRequest || d.price === undefined ? {} : { price: d.price }),
    availability: d.sold ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock',
    itemCondition: 'https://schema.org/UsedCondition',
    areaServed: 'Worldwide',
  },
};
const jsonLdText = JSON.stringify(jsonLd).replace(/</g, '\\u003c');
const enquire = d.sold ? '/#quiz' : enquiryHref(horse);
---

<BaseLayout title={title} description={description} ogImage={d.photos[0]} ogImageAlt={photoAlt(horse, 0, t)} ogType="product">
  <Fragment slot="head">
    {!d.sold && !d.priceOnRequest && d.price !== undefined && (
      <>
        <meta property="product:price:amount" content={String(d.price)} />
        <meta property="product:price:currency" content={d.currency} />
      </>
    )}
    <script type="application/ld+json" set:html={jsonLdText} />
  </Fragment>
  <PageHeader eyebrow={fill(t.detail.eyebrow, vars)} title={d.name} lead={lead} />
  <main id="main" tabindex="-1">
    <div class="wrap">
      <p class="back">
        <a href="/horses/">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
          {t.detail.back}
        </a>
      </p>

      <div class="horse-top">
        <HorseGallery horse={horse} />
        <aside class="summary" aria-labelledby="summary-h">
          <h2 id="summary-h" class="sr-only">{t.detail.factsTitle}</h2>
          {d.sold && <span class="sold-pill">{t.labels.sold}</span>}
          <p class="s-price">{d.sold ? t.labels.sold : price}</p>
          <ul class="s-facts">
            <li>{fill(t.labels.age, { age })}</li>
            <li>{fill(t.labels.height, { height: d.height })}</li>
            <li>{level}</li>
            <li>{country}</li>
          </ul>
          {d.sold ? (
            <>
              <p class="s-note">{t.detail.soldNote}</p>
              <a class="btn" href={enquire}>{t.detail.cta.button}</a>
            </>
          ) : (
            <>
              <a class="btn" href={enquire}>{fill(t.detail.enquire, { name: d.name })}</a>
              <p class="s-note">{t.detail.enquireNote}</p>
            </>
          )}
        </aside>
      </div>

      <div class="horse-body">
        <section class="desc" aria-labelledby="desc-h">
          <h2 id="desc-h">{t.detail.descriptionTitle}</h2>
          <div class="prose"><Content /></div>
          {d.video && (
            <section class="video" aria-labelledby="video-h">
              <h2 id="video-h">{t.detail.videoTitle}</h2>
              {embed ? (
                <div class="video-box">
                  <iframe
                    src={embed}
                    title={`${t.detail.videoTitle}: ${d.name}`}
                    loading="lazy"
                    allow="fullscreen; picture-in-picture; encrypted-media"
                    referrerpolicy="strict-origin-when-cross-origin"
                  ></iframe>
                </div>
              ) : (
                <a class="btn btn-ghost btn-sm" href={d.video} rel="noopener">{t.detail.videoLink}</a>
              )}
            </section>
          )}
        </section>
        <div class="tables">
          <section aria-labelledby="facts-h">
            <h2 id="facts-h">{t.detail.factsTitle}</h2>
            <table class="facts">
              <tbody>
                {facts.map(([k, v]) => <tr><th scope="row">{k}</th><td>{v}</td></tr>)}
              </tbody>
            </table>
          </section>
          <section aria-labelledby="ped-h">
            <h2 id="ped-h">{t.detail.pedigreeTitle}</h2>
            <table class="facts">
              <tbody>
                <tr><th scope="row">{t.detail.facts.sire}</th><td>{d.sire}</td></tr>
                <tr><th scope="row">{t.detail.facts.dam}</th><td>{d.dam}</td></tr>
                <tr><th scope="row">{t.detail.facts.damsire}</th><td>{d.damsire}</td></tr>
              </tbody>
            </table>
          </section>
        </div>
      </div>
    </div>
    <CtaPanel {...t.detail.cta} href={enquire} />
  </main>
</BaseLayout>

<style>
  .back { padding-block: 1.6rem 1.2rem; }
  .back a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600; font-size: 0.95rem; color: var(--accent-text); text-decoration: none; border-radius: 8px; }
  .back a:hover { text-decoration: underline; text-underline-offset: 3px; }
  .back svg { width: 1.1rem; height: 1.1rem; }
  .back a:dir(rtl) svg { transform: scaleX(-1); }

  .horse-top { display: grid; gap: clamp(1.4rem, 3.5vw, 2.6rem); grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); align-items: start; }
  @media (max-width: 899px) { .horse-top { grid-template-columns: 1fr; } }

  .summary { position: relative; display: grid; justify-items: start; gap: 1rem; padding: clamp(1.4rem, 3vw, 2rem); border-radius: 22px; background: var(--surface); border: 1px solid var(--line); box-shadow: 0 10px 40px rgba(41,19,5,.08); }
  .summary .btn { width: 100%; }
  .sold-pill { padding: 0.35rem 0.9rem; border-radius: 999px; background: var(--accent-ink); color: #FFFFFF; font: 700 0.78rem/1.2 var(--sans); letter-spacing: 0.14em; text-transform: uppercase; }
  .s-price { font: 700 clamp(1.6rem, 3.6vw, 2.1rem)/1.15 var(--serif); }
  .s-facts { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; font-size: 0.92rem; color: var(--muted); }
  .s-facts li { padding: 0.2rem 0.75rem; border-radius: 999px; background: var(--accent-soft); }
  .s-note { font-size: 0.9rem; color: var(--muted); }

  .horse-body { display: grid; gap: clamp(2rem, 5vw, 3.6rem); grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); align-items: start; padding-block: clamp(2.6rem, 6vw, 4rem) 1rem; }
  @media (max-width: 899px) { .horse-body { grid-template-columns: 1fr; } }
  .horse-body h2 { font-size: clamp(1.4rem, 3vw, 1.8rem); margin-block-end: 1rem; }
  .prose { font-size: 1.02rem; }
  .prose :global(p), .prose :global(ul) { margin-block: 0 1rem; }
  .prose :global(ul) { padding-inline-start: 1.3rem; }
  .prose :global(a) { color: var(--accent-text); text-underline-offset: 3px; }
  .video { margin-block-start: 2.4rem; }
  .video-box { aspect-ratio: 16 / 9; border-radius: 22px; overflow: hidden; background: var(--accent-soft); }
  .video-box iframe { display: block; width: 100%; height: 100%; border: 0; }

  .tables { display: grid; gap: 2.2rem; }
  .facts { width: 100%; border-collapse: collapse; font-size: 0.97rem; }
  .facts th, .facts td { padding-block: 0.65rem; text-align: start; vertical-align: top; border-block-end: 1px solid var(--line); }
  .facts th { width: 42%; padding-inline-end: 1rem; font-weight: 600; color: var(--muted); }
  .facts tr:first-child th, .facts tr:first-child td { border-block-start: 1px solid var(--line); }
</style>
